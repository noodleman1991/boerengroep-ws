# Settings of the Boerengroep site. Copy this file to .env.local and fill it in.
# .env.local is for your own laptop and is never committed. On Vercel the same names are set
# under the project, Settings, Environment Variables.

# --- Content -----------------------------------------------------------------------------
# The database with all pages, events, pictures and settings of BOTH sites (Payload).
# On a laptop: the Postgres from packages/cms/docker-compose.yml.
PAYLOAD_DATABASE_URL=postgres://payload:payload@127.0.0.1:54329/payload_dev
# Signs logins and preview links, and locks the saved Brevo key. The same on both sites.
# Never change it on a running site: logins stop and the saved Brevo key cannot be read.
PAYLOAD_SECRET=
# Which site this app shows.
TENANT_SLUG=boerengroep
# The password the admin uses to tell this site that something changed.
# The same value is stored with the website under People and websites, Websites.
REVALIDATE_SECRET=
# The public address of this site, without a slash at the end. Both names are read.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# --- Pictures and files ------------------------------------------------------------------
# On Vercel: the token of the Blob store "sites-media" (set by connecting the store).
# BLOB_READ_WRITE_TOKEN=
# On a laptop, without a token: a folder for uploads.
MEDIA_DIR=

# --- Newsletter sign-ups -----------------------------------------------------------------
# A small database of its own, one per site: who signed up, who confirmed, who left, and the
# record of their consent. It is NOT the content database above. Brevo only gets the people
# who confirmed. On a laptop use an address that leads nowhere, so real records stay untouched.
NEWSLETTER_DATABASE_URL=postgres://nobody:nothing@127.0.0.1:1/none
# Signs the links in newsletter emails (confirm, unsubscribe). Keep it the same when the site
# moves, or links in emails that were already sent stop working.
NEWSLETTER_SECRET=

# --- Email -------------------------------------------------------------------------------
# 1 = this copy sends no email at all. Always on a laptop, and on a site that is not live yet.
EMAILS_OFF=1
# The key of Resend, the service that sends the emails.
RESEND_API_KEY=
# The sender. The address must be on a domain that is verified in Resend.
FROM_EMAIL=
FROM_NAME=
# Where an answer to a newsletter email goes. Empty: the contact address in site.config.ts.
REPLY_TO_EMAIL=

# --- Brevo (the mailing list) ------------------------------------------------------------
# Editors set the key and the list number in the admin: Site settings, Newsletter.
# These two are only the fallback for a site where nothing is saved there yet.
# BREVO_API_KEY=
# BREVO_LIST_ID=

# --- Podcast -----------------------------------------------------------------------------
# The feed the podcast page reads. Leave out for a site without a podcast.
PODCAST_RSS_URL=

# --- Only for the first set-up of a database ---------------------------------------------
# The first admin, made by "pnpm seed" in packages/cms.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

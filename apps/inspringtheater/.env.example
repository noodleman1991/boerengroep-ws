# Settings of the Inspringtheater site. Copy this file to .env.local and fill it in.
# Every name is explained in apps/boerengroep/.env.example. Only the differences are noted here.

# --- Content -----------------------------------------------------------------------------
# The same database and the same secret as the Boerengroep site: one admin serves both.
PAYLOAD_DATABASE_URL=postgres://payload:payload@127.0.0.1:54329/payload_dev
PAYLOAD_SECRET=
TENANT_SLUG=inspringtheater
# This site's own value, different from Boerengroep's.
REVALIDATE_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3001
BASE_URL=http://localhost:3001
# This site has no admin of its own: /admin leads to the admin on the Boerengroep site.
ADMIN_URL=http://localhost:3000/admin

# --- Pictures and files ------------------------------------------------------------------
# On Vercel: the same Blob store as Boerengroep.
# BLOB_READ_WRITE_TOKEN=
MEDIA_DIR=

# --- Newsletter sign-ups -----------------------------------------------------------------
# This site's own sign-up database, not Boerengroep's.
NEWSLETTER_DATABASE_URL=postgres://nobody:nothing@127.0.0.1:1/none
NEWSLETTER_SECRET=

# --- Email -------------------------------------------------------------------------------
EMAILS_OFF=1
RESEND_API_KEY=
# The address stays on a domain that is verified in Resend. Today that is boerengroep.nl.
FROM_EMAIL=
FROM_NAME=Stichting Inspringtheater
REPLY_TO_EMAIL=

# --- Brevo (the mailing list) ------------------------------------------------------------
# Set in the admin: Site settings, Newsletter. Use this site's own list.
# BREVO_API_KEY=
# BREVO_LIST_ID=

{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "PAYLOAD_*",
        "TENANT_SLUG",
        "REVALIDATE_SECRET",
        "BASE_URL",
        "ADMIN_URL",
        "BLOB_READ_WRITE_TOKEN",
        "MEDIA_DIR",
        "NEWSLETTER_*",
        "DATABASE_URL",
        "EMAILS_OFF",
        "RESEND_*",
        "FROM_EMAIL",
        "FROM_NAME",
        "REPLY_TO_EMAIL",
        "BREVO_*",
        "PODCAST_RSS_URL",
        "RUN_MIGRATIONS"
      ]
    },
    "dev": { "cache": false, "persistent": true },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": {},
    "test:int": { "cache": false }
  }
}
